# Phase 19: real deployment secrets/config — copy to .env (gitignored),
# fill in real values, never commit the filled-in file.

# Postgres superuser password — used by every service's own DATABASE_URL
# too (one instance, multiple logical databases; see
# deploy/postgres-init/01-create-databases.sql).
POSTGRES_PASSWORD=changeme

# A real target ERP database connection string, resolved by governance's
# secrets_registry.yaml (Phase 7). Read as a plain env var by
# governance/security/secrets.py today — a real Docker `secrets:`
# file-mount would need a small entrypoint wrapper this codebase doesn't
# have yet (docker-compose.yml's own comment names this honestly).
DEMO_ERP_DATABASE_URL=postgresql://user:pass@host:5432/demo_erp

# Gateway's own stub bearer-token map (Phase 2) — same file every
# service's own README already documents.
GATEWAY_TOKEN=dev-admin-token

# Phase 31: "stub" (default) keeps every prior phase's token→actor map
# unchanged. Set "oidc" for real per-user auth through services/identity/
# — Gateway, Control UI, MCP Surface, and the OpenAI shim all read this
# the same way.
AUTH_MODE=stub

# Phase 31: off by default — every prior phase's stub-auth workflow
# decides its own request as the shared "human_admin" actor; this only
# becomes meaningful once AUTH_MODE=oidc gives real, distinct per-user
# identities. Set "true" in a real team deployment.
ENFORCE_APPROVER_NOT_REQUESTER=false

# Real live Odoo instance, resolved by governance's secrets_registry.yaml
# (Phase 29's live_odoo entry, scoped to odoo_agent only). Real XML-RPC
# creds, not Postgres — services/agents/agents/reasoning_engine/odoo_live_bridge.py.
ODOO_CONNECTION_URL=http://username:api_key@host:8069/database_name

# Connecting a real external project (Django, or anything else Shell
# Executor's allowlists cover) — Phase 29/33's own real integration
# path, not a new mechanism. Quote values with spaces. Defaults for
# every one of these keep this repo's own disposable /tmp sandbox
# behavior unchanged if left unset.
# SANDBOX_ROOT="/path/to/your/real/projects"                              # widens Shell Executor's own working-dir boundary — a real, deliberate tradeoff, not cosmetic
# DJANGO_PROJECT_ROOT="/path/to/your/real/projects/your-django-app"       # where manage.py actually lives
# DJANGO_PYTHON_BIN="/path/to/your/real/projects/your-django-app/env/bin/python3"  # the project's OWN venv interpreter — the bare system python3 won't have its real dependencies installed
# PROPOSAL_REPO_PATH="/path/to/your/real/projects/your-django-app"        # the git repo root, for real propose_change branches/commits
# SANDBOX_MEMORY_LIMIT_MB=2048   # default 512MB is too low for a real Django project importing pandas/numpy — raise explicitly, never silently
